import type React from 'react';
import type { EvidenceItem, TreeNode } from '@repo/shared';
import { Table, Info, Cpu, Layers, Terminal, ChevronRight, CheckCircle2, AlertCircle, Clock, FileText, Mail, Send } from 'lucide-react';
import {
    BarChart,
    Bar,
    XAxis,
    YAxis,
    CartesianGrid,
    Tooltip,
    ResponsiveContainer,
    Cell,
    Legend
} from 'recharts';

interface EvidencePanelProps {
    evidence: EvidenceItem[];
    assistantText: string;
    isIdle: boolean;
}

const TreeVisualizer: React.FC<{ node: TreeNode; level?: number }> = ({ node, level = 0 }) => {
    const getStatusColor = (status?: string) => {
        switch (status) {
            case 'matched': return 'text-accent-emerald bg-accent-emerald/10 border-accent-emerald/20';
            case 'exception': return 'text-accent-rose bg-accent-rose/10 border-accent-rose/20';
            case 'pending': return 'text-accent-amber bg-accent-amber/10 border-accent-amber/20';
            default: return 'text-white/40 bg-white/5 border-white/10';
        }
    };

    const getStatusIcon = (status?: string) => {
        switch (status) {
            case 'matched': return <CheckCircle2 size={12} />;
            case 'exception': return <AlertCircle size={12} />;
            case 'pending': return <Clock size={12} />;
            default: return null;
        }
    };

    return (
        <div className="relative">
            {/* Connecting lines */}
            {level > 0 && (
                <div className="absolute -left-6 top-0 bottom-0 w-px bg-white/10">
                    <div className="absolute top-4 left-0 w-4 h-px bg-white/10" />
                </div>
            )}

            <div className={`flex items-start gap-4 p-4 rounded-xl border transition-all duration-300 hover:bg-white/[0.05] shadow-lg mb-4 ${level === 0 ? 'bg-white/[0.07] border-white/20' : 'bg-white/[0.02] border-white/5'}`}>
                <div className={`p-2 rounded-lg ${level === 0 ? 'bg-accent-blue/20 text-accent-blue' : 'bg-white/5 text-white/40'}`}>
                    {level === 0 ? <Layers size={16} /> : <div className="w-4 h-4 rounded-full border-2 border-current opacity-20" />}
                </div>

                <div className="flex-1 min-w-0">
                    <div className="flex items-center justify-between gap-2 mb-1">
                        <h4 className={`font-bold tracking-tight truncate ${level === 0 ? 'text-sm text-white' : 'text-[12px] text-white/80'}`}>
                            {node.name}
                        </h4>
                        {node.status && node.status !== 'neutral' && (
                            <div className={`px-2 py-0.5 rounded-full flex items-center gap-1.5 text-[8px] font-black uppercase tracking-widest border ${getStatusColor(node.status)}`}>
                                {getStatusIcon(node.status)}
                                {node.status}
                            </div>
                        )}
                    </div>
                    {node.description && <p className="text-[10px] text-white/40 line-clamp-1 mb-2 font-medium">{node.description}</p>}
                    {node.value && (
                        <div className="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-[#00d2ff]/10 text-[#00d2ff] text-[10px] font-bold">
                            <ChevronRight size={10} className="opacity-50" />
                            {node.value}
                        </div>
                    )}
                </div>
            </div>

            {node.children && node.children.length > 0 && (
                <div className="ml-10">
                    {node.children.map((child, i) => (
                        <TreeVisualizer key={i} node={child} level={level + 1} />
                    ))}
                </div>
            )}
        </div>
    );
};

export const EvidencePanel: React.FC<EvidencePanelProps> = ({ evidence, assistantText, isIdle }) => {
    if (isIdle) {
        return (
            <div className="flex-1 flex items-center justify-center glass-card border-dashed border-white/5 animate-in fade-in duration-1000">
                <div className="text-center p-8 max-w-sm">
                    <div className="w-20 h-20 bg-white/5 rounded-[28px] border border-white/10 flex items-center justify-center mx-auto mb-8 shadow-2xl relative overflow-hidden group hover:scale-105 transition-transform duration-500">
                        <div className="absolute inset-0 bg-accent-blue/5 animate-pulse" />
                        <Layers size={32} className="text-accent-blue relative z-10" />
                    </div>
                    <h3 className="text-xl font-bold text-white mb-3 tracking-tight">Área de Inteligencia</h3>
                    <p className="text-white/70 leading-relaxed text-[11px]">Inicia una sesión con Amalia para visualizar las evidencias operativas y flujos de datos en tiempo real.</p>
                </div>
            </div>
        );
    }

    return (
        <div className="flex-1 flex flex-col glass-card animate-in slide-in-from-right-8 duration-700">
            <div className="px-8 py-5 border-b border-white/5 flex items-center justify-between bg-white/[0.02] sticky top-0 z-20 backdrop-blur-xl">
                <h2 className="text-lg font-bold text-white flex items-center gap-3 tracking-tight">
                    <Terminal className="text-accent-blue" size={20} />
                    Evidencias Operativas
                </h2>
                <div className="px-3 py-1 bg-accent-blue/20 border border-accent-blue/40 text-accent-blue text-[9px] font-black rounded-lg uppercase tracking-[0.2em]">
                    Live Insight Engine
                </div>
            </div>

            <div className="p-6 space-y-8">
                {/* Assistant Narrative */}
                <div className="bg-white/[0.05] backdrop-blur-3xl rounded-[20px] p-6 border border-white/10 shadow-inner">
                    <p className="text-white leading-relaxed text-[13px] font-medium italic">
                        "{assistantText || "Sincronizando con el servidor..."}"
                    </p>
                </div>

                {/* Evidence Items */}
                {evidence.length > 0 ? (
                    evidence.map((item, idx) => (
                        <div key={idx} className="space-y-4 animate-in fade-in slide-in-from-bottom-4 duration-700" style={{ animationDelay: `${idx * 150}ms` }}>
                            <div className="flex items-center gap-2.5 text-white/60">
                                <Table size={15} className="text-accent-blue" />
                                <span className="text-[10px] font-black uppercase tracking-[0.2em]">{item.title}</span>
                            </div>

                            {/* Chart Display */}
                            {item.chartData && (
                                <div className="bg-white/[0.03] border border-white/10 rounded-2xl p-6 h-[400px] shadow-2xl relative group overflow-hidden">
                                    <div className="absolute top-4 right-6 flex items-center gap-2 z-20">
                                        <div className="w-2 h-2 rounded-full bg-accent-blue animate-pulse" />
                                        <span className="text-[8px] font-black text-white/30 uppercase tracking-[0.2em]">Analítica Visual Live</span>
                                    </div>
                                    <ResponsiveContainer width="100%" height="100%">
                                        <BarChart
                                            data={item.chartData.labels.map((l, i) => {
                                                const dataPoint: any = { name: l, displayName: l };
                                                item.chartData!.datasets.forEach((ds, dsIdx) => {
                                                    dataPoint[`value_${dsIdx}`] = ds.data[i];
                                                    dataPoint[`area_${dsIdx}`] = ds.meta?.[i]?.area || 'General';
                                                    dataPoint[`color_${dsIdx}`] = ds.meta?.[i]?.color || '#00d2ff';
                                                });
                                                return dataPoint;
                                            })}
                                            margin={{ top: 50, right: 30, left: 0, bottom: 100 }}
                                        >
                                            <CartesianGrid strokeDasharray="3 3" stroke="rgba(255,255,255,0.05)" vertical={false} />
                                            <XAxis
                                                dataKey="displayName"
                                                stroke="rgba(255,255,255,0.3)"
                                                fontSize={8}
                                                tickLine={false}
                                                axisLine={false}
                                                interval={0}
                                                angle={-35}
                                                textAnchor="end"
                                                dy={10}
                                            />
                                            <YAxis
                                                stroke="rgba(255,255,255,0.3)"
                                                fontSize={9}
                                                tickLine={false}
                                                axisLine={false}
                                                dx={-10}
                                                domain={[0, 100]}
                                            />
                                            <Tooltip
                                                cursor={{ fill: 'rgba(255,255,255,0.05)' }}
                                                contentStyle={{
                                                    backgroundColor: 'rgba(10, 15, 24, 0.95)',
                                                    border: '1px solid rgba(255,255,255,0.1)',
                                                    borderRadius: '12px',
                                                    padding: '12px',
                                                    backdropFilter: 'blur(10px)',
                                                    boxShadow: '0 20px 40px rgba(0,0,0,0.5)'
                                                }}
                                                itemStyle={{ fontWeight: 'bold', fontSize: '11px' }}
                                                labelStyle={{ color: 'white', marginBottom: '4px', fontSize: '10px', textTransform: 'uppercase', opacity: 0.5 }}
                                            />
                                            <Legend
                                                verticalAlign="top"
                                                align="left"
                                                wrapperStyle={{ paddingTop: '0', paddingLeft: '10px' }}
                                                content={() => {
                                                    const uniqueAreas = Array.from(new Set(item.chartData?.datasets[0].meta?.map((m: any) => m.area) || []));
                                                    return (
                                                        <div className="flex flex-wrap gap-x-6 gap-y-2 mb-6">
                                                            {uniqueAreas.map((area: any, i) => (
                                                                <div key={i} className="flex items-center gap-2">
                                                                    <div className="w-2.5 h-2.5 rounded-full shadow-[0_0_8px_rgba(0,0,0,0.5)]" style={{ backgroundColor: item.chartData?.datasets[0].meta?.find((m: any) => m.area === area)?.color }} />
                                                                    <span className="text-[10px] font-black text-white/50 uppercase tracking-widest">{area}</span>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    );
                                                }}
                                            />
                                            {item.chartData.datasets.map((ds, dsIdx) => (
                                                <Bar
                                                    key={dsIdx}
                                                    name={ds.label}
                                                    dataKey={`value_${dsIdx}`}
                                                    radius={[4, 4, 0, 0]}
                                                    barSize={24}
                                                    animationDuration={1500}
                                                >
                                                    {item.chartData!.labels.map((_, index) => (
                                                        <Cell
                                                            key={`cell-${index}`}
                                                            fill={ds.meta?.[index]?.color || (dsIdx === 0 ? '#00d2ff' : '#f472b6')}
                                                            fillOpacity={0.8}
                                                        />
                                                    ))}
                                                </Bar>
                                            ))}
                                        </BarChart>
                                    </ResponsiveContainer>
                                </div>
                            )}

                            {/* Tree Visualization */}
                            {item.treeData && (
                                <div className="bg-white/[0.02] border border-white/5 rounded-3xl p-8 shadow-2xl relative overflow-hidden group">
                                    <div className="absolute top-6 right-8 flex items-center gap-2 z-20">
                                        <div className="w-2 h-2 rounded-full bg-accent-blue animate-pulse" />
                                        <span className="text-[8px] font-black text-white/30 uppercase tracking-[0.2em]">Dependency Graph Live</span>
                                    </div>
                                    <TreeVisualizer node={item.treeData} />
                                </div>
                            )}

                            {/* Email Draft Visualization */}
                            {item.emailDraft && (
                                <EmailDraftVisualizer draft={item.emailDraft} />
                            )}

                            {/* SQL Preview */}
                            {item.sql && (
                                <div className="bg-[#05080e]/90 rounded-xl p-4 font-mono text-[10px] text-accent-blue/60 overflow-x-auto border border-white/5 shadow-xl relative">
                                    <div className="text-white/20 mb-2 font-sans font-black text-[8px] uppercase tracking-[0.2em] flex items-center gap-2">
                                        <Cpu size={10} />
                                        Query_Exec_Plan.log
                                    </div>
                                    <code className="block leading-relaxed whitespace-pre">
                                        {item.sql}
                                    </code>
                                </div>
                            )}

                            {/* Data Table / RAG Citations */}
                            {!item.chartData && !item.treeData && item.rowsPreview && item.rowsPreview.length > 0 && (
                                item.tool === 'tool_supplier_rag' ? (
                                    <div className="space-y-4">
                                        {item.rowsPreview.map((row, rIdx) => (
                                            <div key={rIdx} className="bg-white/[0.03] border-l-4 border-accent-blue rounded-r-2xl p-6 relative group overflow-hidden shadow-xl animate-in zoom-in-95 duration-500">
                                                <div className="flex items-start gap-4">
                                                    <div className="p-2.5 bg-accent-blue/20 rounded-xl text-accent-blue shrink-0">
                                                        <FileText size={20} />
                                                    </div>
                                                    <div className="space-y-2">
                                                        <p className="text-white/90 text-sm font-serif leading-relaxed italic">
                                                            "{row['Contenido del Documento']}"
                                                        </p>
                                                        <div className="flex items-center gap-2 pt-2 text-[10px] font-black uppercase tracking-widest text-white/40">
                                                            <div className="w-4 h-[1px] bg-white/20" />
                                                            <span>{item.notes || "Documentación Oficial"}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                {/* Decorative elements */}
                                                <div className="absolute -top-10 -right-10 w-32 h-32 bg-accent-blue/5 rounded-full blur-3xl group-hover:bg-accent-blue/10 transition-colors duration-700" />
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <div className="bg-white/[0.03] border border-white/10 rounded-2xl overflow-hidden shadow-2xl backdrop-blur-md">
                                        <div className="overflow-x-auto">
                                            <table className="w-full text-left text-[10px] border-collapse">
                                                <thead>
                                                    <tr className="bg-white/[0.05] border-b border-white/10">
                                                        {Object.keys(item.rowsPreview[0]).map((col) => (
                                                            <th key={col} className="px-5 py-3 font-black text-white/70 uppercase tracking-[0.1em] text-[8.5px]">
                                                                {col.replace(/_/g, ' ')}
                                                            </th>
                                                        ))}
                                                    </tr>
                                                </thead>
                                                <tbody className="divide-y divide-white/[0.05]">
                                                    {item.rowsPreview.map((row: any, rIdx: number) => (
                                                        <tr key={rIdx} className="hover:bg-accent-blue/[0.04] transition-colors group">
                                                            {Object.values(row).map((val: any, vIdx: number) => (
                                                                <td key={vIdx} className="px-5 py-3 text-white/90 font-medium group-hover:text-white transition-colors">
                                                                    {typeof val === 'number' ? (
                                                                        <span className="text-accent-blue font-bold">{val.toLocaleString()}</span>
                                                                    ) : (val === null ? '-' : String(val))}
                                                                </td>
                                                            ))}
                                                        </tr>
                                                    ))}
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                )
                            )}

                            {/* Notes */}
                            {item.notes && (
                                <div className="flex gap-3 bg-accent-purple/10 rounded-xl p-4 border border-accent-purple/20 text-accent-purple text-[11px]">
                                    <Info className="shrink-0 text-accent-purple" size={16} />
                                    <span className="leading-relaxed font-medium">{item.notes}</span>
                                </div>
                            )}
                        </div>
                    ))
                ) : (
                    assistantText && (
                        <div className="text-center py-12 flex flex-col items-center gap-4 opacity-30">
                            <Layers className="text-white/10" size={32} />
                            <p className="text-white/20 font-bold uppercase tracking-[0.2em] text-[9px]">Awaiting Core Insight</p>
                        </div>
                    )
                )}
            </div>
        </div>
    );
};
