# Azure OpenAI (Regular Chat)
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
AZURE_OPENAI_API_KEY=replace-with-your-openai-api-key
AZURE_OPENAI_MODEL=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Azure Speech (STT/TTS Fallback)
AZURE_TTS_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/
AZURE_TTS_API_KEY=replace-with-your-speech-api-key

# Azure Voice Live (Realtime + Avatar)
AZURE_VOICELIVE_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
AZURE_VOICELIVE_API_KEY=replace-with-your-voice-live-api-key
AZURE_VOICELIVE_KEY=replace-with-your-voice-live-api-key
AZURE_VOICELIVE_MODEL=gpt-4o-realtime-preview
AZURE_VOICELIVE_VOICE=es-MX-DaliaNeural

# Dataverse Integration
DATAVERSE_URL=https://your-org.crm.dynamics.com
DATAVERSE_TENANT_ID=replace-with-your-dataverse-tenant-id
DATAVERSE_CLIENT_ID=replace-with-your-dataverse-client-id
DATAVERSE_CLIENT_SECRET=replace-with-your-dataverse-client-secret

# API
API_URL=http://localhost:8080

# Vite Compatibility
VITE_AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
VITE_AZURE_OPENAI_API_KEY=replace-with-your-openai-api-key
VITE_AZURE_TTS_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com/
VITE_AZURE_TTS_API_KEY=replace-with-your-speech-api-key
VITE_AZURE_OPENAI_MODEL=gpt-4o
VITE_AZURE_OPENAI_API_VERSION=2024-10-01-preview
VITE_AZURE_VOICELIVE_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
VITE_AZURE_VOICELIVE_API_KEY=replace-with-your-voice-live-api-key
VITE_AZURE_VOICELIVE_MODEL=gpt-4o-realtime-preview
VITE_AZURE_VOICELIVE_VOICE=es-MX-DaliaNeural
VITE_API_URL=http://localhost:8080

# Email Service (Resend)
RESEND_API_KEY=replace-with-your-resend-api-key
FROM_EMAIL=noreply@example.com

# Microsoft Entra ID Authentication
ENTRA_TENANT_ID=replace-with-your-entra-tenant-id
ENTRA_CLIENT_ID=replace-with-your-entra-client-id
ENTRA_CLIENT_SECRET=replace-with-your-entra-client-secret
ENTRA_REDIRECT_URI=http://localhost:5173

# Vite Compatibility
VITE_ENTRA_TENANT_ID=replace-with-your-entra-tenant-id
VITE_ENTRA_CLIENT_ID=replace-with-your-entra-client-id
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
